<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>VisionMesh.Server</AssemblyName>
    <RootNamespace>VisionMesh.Server</RootNamespace>
    <OutputType>Exe</OutputType>
    <UserSecretsId>visionmesh-server</UserSecretsId>
    <ApplicationIcon>visionmesh.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VisionMesh.Api\VisionMesh.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The dashboard is plain HTML/CSS/JS with no build step, copied in at publish time. -->
    <Content Include="..\..\web\dashboard\**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
